<!DOCTYPE html>
<html>

  <%= render "layouts/head" %>
  <body class="bg-stone-50 text-stone-900 antialiased pt-15">
  <%= render "layouts/header" %>
    <main class="max-w-6xl mx-auto px-4 pt-12 pb-16">
      <% flash.each do |message_type, message| %>
          <%
            bg_style = case message_type.to_s
                       when 'notice', 'success'

                         "bg-emerald-50/70 text-emerald-900 border-emerald-200/80"
                      when 'alert', 'danger', 'error'

                         "bg-rose-50/70 text-rose-950 border-rose-200/80"
                       else
                         "bg-stone-50 text-stone-900 border-stone-200"
                       end
          %>


        <%= content_tag(:div, message,
                        class: "mb-6 p-5 rounded-2xl border shadow-[0_20px_40px_-10px_rgba(0,0,0,0.15)] text-sm font-black tracking-wider uppercase flex items-center justify-center text-center gap-3 animate-in fade-in slide-in-from-top-4 duration-300 #{bg_style}")
        %>
      <% end %>
      <%= yield %>
      <%= render "layouts/footer" %>
      <% if Rails.env.development? %>
        <div class="mt-16 p-6 bg-stone-100/80 border border-stone-200/60 rounded-2xl text-xs font-mono text-stone-600 max-w-full overflow-x-auto shadow-inner">
          <div class="font-bold uppercase tracking-wider text-stone-400 mb-2 text-[10px]">
            Development Debug Console
          </div>
          <%= debug(params) %>
        </div>
      <% end %>
    </main>
  </body>
</html>
