<li id="micropost-<%= micropost.id %>" class="relative flex items-start gap-3.5 p-4 rounded-xl bg-stone-50/50 border border-stone-100 hover:border-stone-200/80 transition-colors group">

  <!-- Sol: Profil Resmi -->
  <div class="w-10 h-10 bg-stone-100 rounded-full border border-stone-200 overflow-hidden shrink-0 flex items-center justify-center [&>img]:w-full [&>img]:h-full [&>img]:object-cover [&>img]:rounded-full">
    <%= link_to gravatar_for(micropost.user, size: 40), micropost.user %>
  </div>

  <!-- Sağ: İçerik Bloğu -->
  <div class="flex-1 min-w-0 pr-8">
    <!-- Üst Satır: Kullanıcı Adı + Nokta + Tarih -->
    <div class="flex items-center gap-1.5 mb-1 text-xs">
      <%= link_to micropost.user.name, micropost.user, class: "font-semibold text-stone-900 hover:underline tracking-tight text-sm" %>
      <span class="text-stone-300">·</span>
      <span class="text-stone-400 font-normal"><%= time_ago_in_words(micropost.created_at) %></span>
    </div>

    <!-- Metin -->
    <p class="text-stone-800 text-sm leading-relaxed wrap-break-words mb-2.5">
      <%= micropost.content %>
    </p>

    <!-- Fotoğraf (Metnin Altında) -->
    <% if micropost.image.attached? %>
      <div class="mt-2 mb-1">
        <%= image_tag micropost.image.variant(:display), class: "rounded-xl border border-stone-200/80 shadow-2xs max-w-full h-auto block" %>
      </div>
    <% end %>
  </div>

  <!-- Silme Butonu -->
  <% if current_user?(micropost.user) %>
    <div class="absolute top-3.5 right-3.5">
      <%= link_to micropost,
            class: "inline-flex items-center justify-center p-1.5 text-stone-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all opacity-0 group-hover:opacity-100",
            title: "Delete micropost",
            data: { "turbo-method": :delete, turbo_confirm: "You sure?" } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      <% end %>
    </div>
  <% end %>

</li>
