<% provide(:title, "Log in") %>
<div class="flex flex-col items-center justify-center min-h-[75vh] px-4 mt-12 mb-16 animate-in fade-in duration-500">
  <div class="w-full max-w-2xl bg-white p-10 md:p-12 rounded-3xl shadow-[0_20px_50px_-20px_rgba(0,0,0,0.03)] border border-stone-100">

    <h1 class="text-3xl font-black tracking-tight text-stone-900 text-center mb-10">
      Log in
    </h1>

    <%= form_with(url: login_path, scope: :session, class: "space-y-6") do |f| %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">

        <div>
          <%= f.label :email,
                      class: "block text-[11px] font-bold text-stone-400 uppercase tracking-widest mb-2" %>
          <%= f.email_field :email,
                            placeholder: "akif@example.com",
          class: "w-full rounded-xl px-4 py-3.5 text-base bg-stone-50 text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-stone-900/10 border border-stone-200/40 focus:border-stone-300 transition duration-200" %>
        </div>


        <div>
          <div class="flex items-baseline gap-2 mb-2">
            <%= f.label :password,
                        class: "text-[11px] font-bold text-stone-400 uppercase tracking-widest" %>
            <%= link_to "(forgot password)",
                        new_password_reset_path,
                        class: "text-xs font-medium text-stone-400 hover:text-stone-200 transition-colors duration-150 underline decoration-stone-600/60 hover:decoration-stone-400 underline-offset-4 cursor-pointer" %>
          </div>
          <%= f.password_field :password,
                               placeholder: "••••••••",
                               class: "w-full rounded-xl px-4 py-3.5 text-base bg-stone-50 text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-stone-900/10 border border-stone-200/40 focus:border-stone-300 transition duration-200" %>
        </div>

      </div>

      <div class="flex items-center space-x-3 pt-2">
        <div class="inline-flex items-center cursor-pointer select-none group">
          <%= f.check_box :remember_me,
                          class: "peer appearance-none w-5 h-5 rounded-md border border-stone-300 bg-stone-50 cursor-pointer
                checked:bg-stone-900 checked:border-stone-900
                focus:outline-none focus:ring-2 focus:ring-stone-950/10 focus:ring-offset-2
                transition-all duration-200 relative
                after:content-[''] after:absolute after:hidden peer-checked:after:block
                after:left-[6px] after:top-[2px] after:w-[6px] after:h-[10px]
                after:border-white after:border-r-2 after:border-b-2 after:rotate-45" %>

          <%= f.label :remember_me, "Remember me on this computer",
                      class: "ml-3 text-sm font-medium text-stone-500 group-hover:text-stone-800 cursor-pointer transition duration-200" %>
        </div>
      </div>

      <div class="pt-6 flex flex-col items-center gap-6">
        <%= f.submit "Log in",
                     class: "w-full md:max-w-xs bg-stone-900 hover:bg-stone-800 text-stone-100 font-bold text-sm tracking-wider uppercase py-4 px-8 rounded-xl cursor-pointer shadow-md hover:shadow-lg transition duration-200 text-center block active:scale-[0.99]" %>

        <div class="w-full border-t border-stone-100 pt-6 text-center">
          <p class="text-xs font-medium text-stone-400 tracking-tight">
            New user?
            <%= link_to "Sign up now!", signup_path,
                        class: "text-stone-900 font-bold hover:text-stone-600 underline underline-offset-4 transition duration-200 ml-1" %>
          </p>
        </div>
      </div>

    <% end %>
  </div>
</div>
