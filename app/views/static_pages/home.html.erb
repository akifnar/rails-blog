<% if logged_in? %>
  <div>
    <aside>
      <%= render 'shared/user_info' %>
      <%= render 'shared/stats', user: @user %>
      <%= render 'shared/micropost_form', micropost: @micropost %>
    </aside>
    <div>
      <h3 class="text-xl font-bold tracking-tight text-stone-900 mb-4 flex items-center gap-2">
        <span class="w-1.5 h-5 bg-stone-800 rounded-full inline-block"></span>
        Micropost Feed
      </h3>
      <%= render 'shared/feed', feed_items: @feed_items %>
    </div>
  </div>
<% else %>
  <%= render 'static_home' %>
<% end %>
