<% provide(:title, @title) %>

<div class="max-w-6xl mx-auto px-4 py-8 grid grid-cols-1 md:grid-cols-12 gap-8">

  <aside class="md:col-span-4 space-y-6">

    <section class="bg-white border border-stone-200/80 rounded-2xl p-6 shadow-sm overflow-hidden transition-all hover:border-stone-300">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 bg-stone-100 rounded-full border border-stone-200 shadow-inner overflow-hidden shrink-0 flex items-center justify-center [&>a]:w-full [&>a]:h-full [&>a>img]:w-full [&>a>img]:h-full [&>a>img]:object-cover [&>a>img]:rounded-full hover:opacity-90 transition-opacity">
          <%= link_to gravatar_for(@user, size: 50), @user %>
        </div>

        <div class="flex-1 min-w-0">
          <h1 class="text-base font-bold tracking-tight text-stone-900 truncate">
            <%= @user.name %>
          </h1>
          <%= link_to "view my profile", @user, class: "inline-block text-xs font-medium text-stone-500 hover:text-stone-900 transition-colors underline-offset-2 hover:underline mt-0.5" %>
        </div>
      </div>

      <div class="mt-4 pt-4 border-t border-stone-100 flex items-center justify-between">
        <div class="[&_.stats]:py-0 [&_.stats>div]:flex [&_.stats>div]:items-center [&_.stats>div]:gap-4 [&_.stats>div>a]:flex [&_.stats>div>a]:items-center [&_.stats>div>a]:gap-1.5 [&_.stats>div>a]:text-xs [&_.stats>div>.w-px]:hidden">
          <%= render 'shared/stats', user: @user %>
        </div>
      </div>

      <div class="mt-4 pt-4 border-t border-stone-100 flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-stone-400">
          Posts
        </span>
        <span class="inline-flex items-center rounded-full bg-stone-100 px-2.5 py-0.5 text-xs font-semibold text-stone-700 border border-stone-200/60">
          <%= pluralize(@user.microposts.count, "micropost") %>
        </span>
      </div>
    </section>

    <section class="bg-white border border-stone-200/80 rounded-2xl p-6 shadow-sm">
      <% if @users.any? %>
        <div class="pt-1">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-stone-400 mb-3">
            Users
          </h3>
          <div class="flex flex-wrap gap-2">
            <% @users.each do |user| %>
              <div class="w-10 h-10 bg-stone-100 rounded-full border border-stone-200 overflow-hidden flex items-center justify-center [&>a]:w-full [&>a]:h-full [&>a>img]:w-full [&>a>img]:h-full [&>a>img]:object-cover [&>a>img]:rounded-full hover:opacity-90 transition-opacity">
                <%= link_to gravatar_for(user, size: 40), user %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </section>
  </aside>

  <main class="md:col-span-8">
    <section class="bg-white border border-stone-200/80 rounded-2xl p-6 md:p-8 shadow-sm">
      <h3 class="text-lg font-bold tracking-tight text-stone-900 border-b border-stone-100 pb-4 mb-6">
        <%= @title %>
      </h3>

      <% if @users.any? %>
        <ul class="divide-y divide-stone-100 space-y-3">
          <%= render @users %>
        </ul>


        <div class="mt-8 flex justify-center [&_.pagination]:flex [&_.pagination]:items-center [&_.pagination]:gap-1 [&_.pagination_a]:px-3 [&_.pagination_a]:py-1.5 [&_.pagination_a]:text-xs [&_.pagination_a]:font-medium [&_.pagination_a]:text-stone-600 [&_.pagination_a]:bg-white [&_.pagination_a]:border [&_.pagination_a]:border-stone-200 [&_.pagination_a]:rounded-md [&_.pagination_a]:transition-colors [&_.pagination_a:hover]:bg-stone-100 [&_.pagination_a:hover]:text-stone-900 [&_.current]:px-3 [&_.current]:py-1.5 [&_.current]:text-xs [&_.current]:font-semibold [&_.current]:text-stone-900 [&_.current]:bg-stone-200/70 [&_.current]:border [&_.current]:border-stone-300 [&_.current]:rounded-md [&_.disabled]:opacity-40 [&_.disabled]:pointer-events-none">
          <%= will_paginate %>
        </div>
      <% else %>
        <p class="text-sm text-stone-500 italic py-4">No users found.</p>
      <% end %>
    </section>
  </main>

</div>
