<% provide(:title, "Sign up") %>
<div class="flex flex-col items-center justify-center min-h-[60vh] px-4 mt-8">
  <div class="w-full max-w-sm bg-white p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.03)] border border-stone-100">

    <h1 class="text-xl font-bold tracking-tight text-stone-900 text-center mb-8">
      Sign up
    </h1>

    <%= form_with(model: @user, class: "space-y-5") do |f| %>

      <div>
        <%= render "shared/error_messages" %>
      </div>

      <div>
        <%= f.label :name,
                    class: "block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5" %>
        <%= f.text_field :name,
                         placeholder: "John Doe",
                         class: "w-full rounded-xl px-4 py-3 text-sm bg-stone-100 text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-stone-900/10 border border-transparent focus:border-stone-200 transition duration-200" %>
      </div>

      <div>
        <%= f.label :email,
                    class: "block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5" %>
        <%= f.email_field :email,
                          placeholder: "example@domain.com",
                          class: "w-full rounded-xl px-4 py-3 text-sm bg-stone-100 text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-stone-900/10 border border-transparent focus:border-stone-200 transition duration-200" %>
      </div>

      <div>
        <%= f.label :password,
                    class: "block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5" %>
        <%= f.password_field :password,
                             placeholder: "••••••••",
                             class: "w-full rounded-xl px-4 py-3 text-sm bg-stone-100 text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-stone-900/10 border border-transparent focus:border-stone-200 transition duration-200" %>
      </div>

      <div>
        <%= f.label :password_confirmation,
                    "Confirmation",
                    class: "block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5" %>
        <%= f.password_field :password_confirmation,
                             placeholder: "••••••••",
                             class: "w-full rounded-xl px-4 py-3 text-sm bg-stone-100 text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-stone-900/10 border border-transparent focus:border-stone-200 transition duration-200" %>
      </div>

      <div class="pt-6">
        <%= f.submit "REGISTER",
                     class: "w-full bg-stone-900 hover:bg-stone-800 text-stone-100 font-bold text-xs uppercase tracking-[0.2em] py-4 px-4 rounded-xl cursor-pointer shadow-md hover:shadow-lg transition duration-200 text-center block active:scale-[0.99]" %>
      </div>

    <% end %>
  </div>
</div>