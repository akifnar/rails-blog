<% provide(:title, @user.name) %>
<div class="flex flex-wrap px-4 py-8 max-w-6xl mx-auto mt-12 gap-8">
  <aside class="w-full md:w-1/3">
    <section class="bg-white border border-stone-200/80 rounded-2xl p-6 shadow-sm overflow-hidden">
      <div class="flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left">

        <div class="w-20 h-20 bg-stone-100 rounded-full border border-stone-200 shadow-inner overflow-hidden shrink-0 flex items-center justify-center [&>img]:w-full [&>img]:h-full [&>img]:object-cover [&>img]:rounded-full">
          <%= gravatar_for @user, size: 80 %>
        </div>

        <div>
          <h1 class="text-xl font-bold tracking-tight text-stone-900 mb-1">
            <%= @user.name %>
          </h1>
          <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">
            User Profile
          </p>
        </div>
      </div>
    </section>
  </aside>

  <div class="w-full md:flex-1">
    <% if @user.microposts.any? %>
      <div class="bg-white border border-stone-200/80 rounded-2xl p-6 shadow-sm">
        <h3 class="text-lg font-bold text-stone-900 mb-6 pb-4 border-b border-stone-100 flex items-center justify-between">
          <span>Microposts</span>
          <span class="text-xs font-semibold bg-stone-100 text-stone-600 px-2.5 py-1 rounded-full">
            <%= @user.microposts.count %>
          </span>
        </h3>

        <ol class="space-y-4">
          <%= render @microposts %>
        </ol>

        <div class="mt-8 flex justify-center [&_.pagination]:flex [&_.pagination]:items-center [&_.pagination]:gap-1 [&_.pagination_a]:px-3 [&_.pagination_a]:py-1.5 [&_.pagination_a]:text-xs [&_.pagination_a]:font-medium [&_.pagination_a]:text-stone-600 [&_.pagination_a]:bg-white [&_.pagination_a]:border [&_.pagination_a]:border-stone-200 [&_.pagination_a]:rounded-md [&_.pagination_a]:transition-colors [&_.pagination_a:hover]:bg-stone-100 [&_.pagination_a:hover]:text-stone-900 [&_.current]:px-3 [&_.current]:py-1.5 [&_.current]:text-xs [&_.current]:font-semibold [&_.current]:text-stone-900 [&_.current]:bg-stone-200/70 [&_.current]:border [&_.current]:border-stone-300 [&_.current]:rounded-md [&_.disabled]:opacity-40 [&_.disabled]:pointer-events-none">
          <%= will_paginate @microposts %>
        </div>
      </div>
    <% end %>
  </div>
</div>
