<% provide(:title, @user.name) %>

<div class="max-w-6xl mx-auto px-4 py-8 grid grid-cols-1 md:grid-cols-12 gap-8 mt-6">

  <aside class="md:col-span-4 space-y-6">
    <section class="bg-white border border-stone-200/80 rounded-2xl p-6 shadow-sm overflow-hidden transition-all hover:border-stone-300">

      <div class="flex flex-col items-center text-center">
        <div class="w-24 h-24 bg-stone-100 rounded-full border-2 border-stone-200/80 shadow-inner overflow-hidden shrink-0 flex items-center justify-center [&>a]:w-full [&>a]:h-full [&>a>img]:w-full [&>a>img]:h-full [&>a>img]:object-cover [&>a>img]:rounded-full hover:opacity-95 transition-all mb-4">
          <%= gravatar_for @user, size: 120 %>
        </div>

        <h1 class="text-lg font-bold tracking-tight text-stone-900 truncate w-full">
          <%= @user.name %>
        </h1>
      </div>

      <div class="mt-8 pt-7 border-t border-stone-100 flex items-center justify-between gap-4">
        <div class="flex-1">
          <%= render 'shared/stats', user: @user %>
        </div>

        <% if logged_in? %>
          <div class="shrink-0">
            <%= render 'follow_form' %>
          </div>
        <% end %>
      </div>

    </section>
  </aside>

  <main class="md:col-span-8">
    <section class="bg-white border border-stone-200/80 rounded-2xl p-6 md:p-8 shadow-sm">
      <div class="flex items-center justify-between border-b border-stone-100 pb-4 mb-6">
        <h3 class="text-lg font-bold tracking-tight text-stone-900">
          Microposts
        </h3>
        <span class="inline-flex items-center rounded-full bg-stone-100 px-3.5 py-1.5 text-xs font-semibold text-stone-700 border border-stone-200/60 shadow-2xs">
          <%= @user.microposts.count %>
        </span>
      </div>

      <% if @user.microposts.any? %>
        <ol class="space-y-4 divide-y divide-stone-100 [&>li]:pt-4 first:[&>li]:pt-0">
          <%= render @microposts %>
        </ol>

        <div class="mt-8 flex justify-center [&_.pagination]:flex [&_.pagination]:items-center [&_.pagination]:gap-1 [&_.pagination_a]:px-3 [&_.pagination_a]:py-1.5 [&_.pagination_a]:text-xs [&_.pagination_a]:font-medium [&_.pagination_a]:text-stone-600 [&_.pagination_a]:bg-white [&_.pagination_a]:border [&_.pagination_a]:border-stone-200 [&_.pagination_a]:rounded-md [&_.pagination_a]:transition-colors [&_.pagination_a:hover]:bg-stone-100 [&_.pagination_a:hover]:text-stone-900 [&_.current]:px-3 [&_.current]:py-1.5 [&_.current]:text-xs [&_.current]:font-semibold [&_.current]:text-stone-900 [&_.current]:bg-stone-200/70 [&_.current]:border [&_.current]:border-stone-300 [&_.current]:rounded-md [&_.disabled]:opacity-40 [&_.disabled]:pointer-events-none">
          <%= will_paginate @microposts%>
        </div>
      <% else %>
        <p class="text-sm text-stone-500 italic py-4">No microposts yet.</p>
      <% end %>
    </section>
  </main>

</div>
