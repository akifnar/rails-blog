<% provide(:title, @user.name) %>
<div class="flex flex-wrap px-4 py-8 max-w-6xl mx-auto mt-12">
  <aside class="w-full md:w-1/3">
    <section class="bg-white border border-stone-200/80 rounded-2xl p-6 shadow-sm overflow-hidden">
      <div class="flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left">

        <div class="w-20 h-20 bg-stone-100 rounded-full border border-stone-200 shadow-inner overflow-hidden flex-shrink-0 flex items-center justify-center [&>img]:w-full [&>img]:h-full [&>img]:object-cover [&>img]:rounded-full">
          <%= gravatar_for @user, size: 80 %>
        </div>

        <div>
          <h1 class="text-xl font-bold tracking-tight text-stone-900 mb-1">
            <%= @user.name %>
          </h1>
          <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">
            User Profile
          </p>
        </div>
      </div>
    </section>
  </aside>
</div>