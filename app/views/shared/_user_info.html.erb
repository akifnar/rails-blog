<section class="bg-white border border-stone-200/80 rounded-2xl p-6 shadow-sm overflow-hidden mb-6 transition-all hover:border-stone-300">
  <div class="flex items-center gap-4">
    <div class="w-14 h-14 bg-stone-100 rounded-full border border-stone-200 shadow-inner overflow-hidden shrink-0 flex items-center justify-center [&>a]:w-full [&>a]:h-full [&>a>img]:w-full [&>a>img]:h-full [&>a>img]:object-cover [&>a>img]:rounded-full hover:opacity-90 transition-opacity">
      <%= link_to gravatar_for(current_user, size: 50), current_user %>
    </div>

    <div class="flex-1 min-w-0">
      <h1 class="text-base font-bold tracking-tight text-stone-900 truncate">
        <%= current_user.name %>
      </h1>
      <%= link_to "view my profile", current_user, class: "inline-block text-xs font-medium text-stone-500 hover:text-stone-900 transition-colors underline-offset-2 hover:underline mt-0.5" %>
    </div>
  </div>

  <div class="mt-4 pt-4 border-t border-stone-100 flex items-center justify-between">
    <span class="text-xs font-semibold uppercase tracking-wider text-stone-400">
      Posts
    </span>
    <span class="inline-flex items-center rounded-full bg-stone-100 px-2.5 py-0.5 text-xs font-semibold text-stone-700 border border-stone-200/60">
      <%= pluralize(current_user.microposts.count, "micropost") %>
    </span>
  </div>
</section>
