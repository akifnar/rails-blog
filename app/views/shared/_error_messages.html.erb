<% if @user.errors.any? %>
  <div class="w-full rounded-xl border-l-4 border-stone-600 bg-stone-100 p-4 text-sm shadow-sm mb-4">
    <div class="font-bold text-stone-800 mb-2">
      Form <%= pluralize(@user.errors.count, "hata") %> içeriyor:
    </div>
    <ul class="list-none space-y-1.5 text-stone-600">
      <% @user.errors.full_messages.each do |msg| %>
        <li class="flex items-start gap-2">
          <span class="text-stone-400 select-none">•</span>
          <span><%= msg %></span>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>